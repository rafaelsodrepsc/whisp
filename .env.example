# Copie para .env e preencha. Nunca faça commit do .env.

# Origem pública do site: esquema e host, sem barra final (ex.: https://chat.seudominio.com).
# Mais de uma origem: separe por vírgula, sem espaços (ex.: http://localhost,http://localhost:4200).
PUBLIC_ORIGIN=http://localhost

# Gere com: openssl rand -base64 32
# O compose interpreta "$" nos valores do .env: para senhas escritas à mão use aspas simples
# ou gere com openssl rand -hex 16.
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# O cookie de refresh só trafega por HTTPS. Use false apenas em HTTP local.
COOKIE_SECURE=true

# Porta do host para o nginx (80 em produção).
WEB_PORT=80

# Opcionais: heap das JVMs e do Kafka (padrões pensados para uma instância de 4 GB).
# JAVA_TOOL_OPTIONS=-Xmx384m
# KAFKA_HEAP_OPTS=-Xmx512m -Xms256m
